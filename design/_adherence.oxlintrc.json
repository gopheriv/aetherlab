{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "components/pipeline/**",
              "ui_kits/aetherlab-desktop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|busy|quality|onQualityChange|examples|onRun|onCancel|key|ref|className|style|children)$/]",
        "message": "<CommandBar> doesn't accept that prop. Declared props: value, onChange, placeholder, busy, quality, onQualityChange, examples, onRun, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandBar'] > JSXAttribute[name.name='quality'] > Literal[value!=/^(?:draft|standard|high)$/]",
        "message": "<CommandBar> quality must be one of 'draft' | 'standard' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DerivationStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|equation|key|ref|className|style|children)$/]",
        "message": "<DerivationStep> doesn't accept that prop. Declared props: text, equation."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavRailItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<NavRailItem> doesn't accept that prop. Declared props: icon, label, active, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ParameterRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|defaultValue|onChange|key|ref|className|style|children)$/]",
        "message": "<ParameterRow> doesn't accept that prop. Declared props: label, value, min, max, step, unit, defaultValue, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='PipelineStage'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|status|elapsed|key|ref|className|style|children)$/]",
        "message": "<PipelineStage> doesn't accept that prop. Declared props: label, status, elapsed."
      },
      {
        "selector": "JSXOpeningElement[name.name='PipelineStage'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pending|active|complete|error)$/]",
        "message": "<PipelineStage> status must be one of 'pending' | 'active' | 'complete' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReferenceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|page|score|excerpt|onOpen|key|ref|className|style|children)$/]",
        "message": "<ReferenceCard> doesn't accept that prop. Declared props: source, page, score, excerpt, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|kind|value|options|placeholder|hint|onChange|onBrowse|key|ref|className|style|children)$/]",
        "message": "<SettingsField> doesn't accept that prop. Declared props: label, kind, value, options, placeholder, hint, onChange, onBrowse."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsField'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:text|select|path|secret)$/]",
        "message": "<SettingsField> kind must be one of 'text' | 'select' | 'path' | 'secret'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|message|detail|onDismiss|onDetails|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: kind, message, detail, onDismiss, onDetails."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:error|warning|info|success)$/]",
        "message": "<Toast> kind must be one of 'error' | 'warning' | 'info' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:playing|currentTime|duration|progress|speed|onPlayPause|onStop|onSeek|onSpeedChange|onSave|key|ref|className|style|children)$/]",
        "message": "<VideoControls> doesn't accept that prop. Declared props: playing, currentTime, duration, progress, speed, onPlayPause, onStop, onSeek, onSpeedChange, onSave."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
